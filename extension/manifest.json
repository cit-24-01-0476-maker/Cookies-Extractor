{
    "manifest_version":  3,
    "name":  "Spotify, Netflix \u0026 Crunchyroll Cookie Auto-Injector",
    "version":  "2.3",
    "description":  "Injects Spotify, Netflix and Crunchyroll session cookies directly from web hub",
    "permissions":  [
                        "cookies",
                        "tabs"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e",
                             "*://*.spotify.com/*",
                             "*://*.netflix.com/*",
                             "https://www.netflix.com/*",
                             "*://*.crunchyroll.com/*",
                             "https://www.crunchyroll.com/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "externally_connectable":  {
                                   "matches":  [
                                                   "http://localhost/*",
                                                   "http://localhost:*/*",
                                                   "http://127.0.0.1/*",
                                                   "http://127.0.0.1:*/*",
                                                   "https://cit-24-01-0476-maker.github.io/*",
                                                   "https://*.github.io/*",
                                                   "https://*.vercel.app/*",
                                                   "https://*.netlify.app/*"
                                               ]
                               },
    "key":  ""
}
